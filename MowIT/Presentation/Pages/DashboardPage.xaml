<ContentPage
    x:Class="MowIT.Presentation.Pages.DashboardPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:MowIT.Presentation.ViewModels"
    x:DataType="vm:DashboardViewModel"
    Shell.NavBarIsVisible="False"
    BackgroundColor="{StaticResource PageBg}">

    <Grid RowDefinitions="Auto,*">

        <Grid Grid.RowSpan="2" InputTransparent="True">
            <Ellipse Fill="{StaticResource EarthPrimary}" Opacity="0.06"
                     WidthRequest="300" HeightRequest="300"
                     HorizontalOptions="End" VerticalOptions="Start"
                     Margin="0,-100,-100,0"/>
        </Grid>

        <Grid Grid.Row="0" Padding="22,52,22,14" ColumnDefinitions="*,Auto">
            <VerticalStackLayout Spacing="2">
                <Label Text="MowIT"
                       FontSize="28" FontAttributes="Bold"
                       TextColor="{StaticResource TextMain}"/>
                <Label Text="{Binding Greeting}"
                       FontSize="12" TextColor="{StaticResource TextMuted}"/>
            </VerticalStackLayout>
        </Grid>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="18,0,18,28" Spacing="12"
                                 HorizontalOptions="{OnIdiom Default=Fill, Desktop=Center}"
                                 WidthRequest="{OnIdiom Default=-1, Desktop=960}">

                <Grid ColumnSpacing="14" RowSpacing="12"
                      ColumnDefinitions="{OnIdiom Default='*', Desktop='1*,1.05*'}"
                      RowDefinitions="{OnIdiom Default='Auto,Auto', Desktop='Auto'}">

                <Border Grid.Row="0" Grid.Column="0" VerticalOptions="Start"
                        Stroke="Transparent"
                        StrokeShape="RoundRectangle 28"
                        Padding="20"
                        BackgroundColor="{Binding StateColor}">
                    <Border.Shadow>
                        <Shadow Brush="#40000000" Offset="0,10" Radius="24" Opacity="0.35"/>
                    </Border.Shadow>

                    <VerticalStackLayout Spacing="16">

                        <Grid ColumnDefinitions="*,Auto">
                            <VerticalStackLayout Spacing="3">
                                <Label Text="CURRENT STATE"
                                       FontSize="10" FontAttributes="Bold"
                                       TextColor="White" Opacity="0.72"
                                       CharacterSpacing="1.6"/>
                                <Label Text="{Binding StateLabel}"
                                       FontSize="32" FontAttributes="Bold"
                                       TextColor="White"/>
                            </VerticalStackLayout>
                        </Grid>

                        <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                            <Border Stroke="Transparent" StrokeShape="RoundRectangle 16"
                                    BackgroundColor="#22FFFFFF" Padding="12,10">
                                <VerticalStackLayout Spacing="3">
                                    <Label Text="POWER"
                                           FontSize="10" FontAttributes="Bold"
                                           TextColor="White" Opacity="0.72"/>
                                    <Label Text="{Binding OnOffLabel}"
                                           FontSize="14" FontAttributes="Bold"
                                           TextColor="White"/>
                                </VerticalStackLayout>
                            </Border>
                            <Border Grid.Column="1"
                                    Stroke="Transparent" StrokeShape="RoundRectangle 16"
                                    BackgroundColor="#22FFFFFF" Padding="12,10">
                                <VerticalStackLayout Spacing="3">
                                    <Label Text="LINK"
                                           FontSize="10" FontAttributes="Bold"
                                           TextColor="White" Opacity="0.72"/>
                                    <Label Text="{Binding ConnectionLabel}"
                                           FontSize="14" FontAttributes="Bold"
                                           TextColor="White" LineBreakMode="TailTruncation"/>
                                </VerticalStackLayout>
                            </Border>
                        </Grid>

                        <Label Text="{Binding ReadinessText}"
                               FontSize="11"
                               TextColor="White" Opacity="0.85"
                               HorizontalOptions="Center"/>

                        <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                            <Button Text="Mow"
                                    Command="{Binding StartMowingCommand}"
                                    IsEnabled="{Binding CanStartMowing}"
                                    Opacity="{Binding CanStartMowing, Converter={StaticResource BoolToOpacity}}"
                                    HeightRequest="50" CornerRadius="18"
                                    FontSize="15" FontAttributes="Bold"
                                    BackgroundColor="White"
                                    TextColor="{Binding StateColor}"/>
                            <Button Grid.Column="1"
                                    Text="⏹ Stop"
                                    Command="{Binding StopCommand}"
                                    HeightRequest="50" CornerRadius="18"
                                    FontSize="15" FontAttributes="Bold"
                                    BackgroundColor="#28FFFFFF"
                                    TextColor="White"/>
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <VerticalStackLayout Spacing="12"
                        Grid.Row="{OnIdiom Default=1, Desktop=0}"
                        Grid.Column="{OnIdiom Default=0, Desktop=1}">

                <HorizontalStackLayout Spacing="10" Margin="2,4,0,0">
                    <BoxView Color="{StaticResource EarthAccent}"
                             WidthRequest="3" HeightRequest="16"
                             VerticalOptions="Center" CornerRadius="2"/>
                    <Label Text="LIVE TELEMETRY" Style="{StaticResource SectionLabel}"
                           VerticalOptions="Center"/>
                </HorizontalStackLayout>

                <Grid ColumnDefinitions="*,*"
                      RowDefinitions="Auto,Auto,Auto,Auto"
                      ColumnSpacing="12" RowSpacing="12">

                    <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource StatTileBorder}">
                        <VerticalStackLayout Spacing="7">
                            <HorizontalStackLayout Spacing="7">
                                <Label Text="BATTERY" Style="{StaticResource SectionLabel}" VerticalOptions="Center"/>
                            </HorizontalStackLayout>
                            <Label Text="{Binding BatteryPct, StringFormat='{0}%'}"
                                   FontSize="24" FontAttributes="Bold"
                                   TextColor="{Binding BatteryPct, Converter={StaticResource BatteryToColor}}"/>
                            <ProgressBar Progress="{Binding BatteryPct, Converter={StaticResource PctToFraction}}"
                                         ProgressColor="{Binding BatteryPct, Converter={StaticResource BatteryToColor}}"
                                         HeightRequest="6" Margin="0,2,0,0"/>
                        </VerticalStackLayout>
                    </Border>

                    <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource StatTileBorder}">
                        <VerticalStackLayout Spacing="7">
                            <HorizontalStackLayout Spacing="7">
                                <Label Text="SPEED" Style="{StaticResource SectionLabel}" VerticalOptions="Center"/>
                            </HorizontalStackLayout>
                            <Label Text="{Binding SpeedLabel}"
                                   FontSize="24" FontAttributes="Bold"
                                   TextColor="{StaticResource TextMain}"/>
                            <Label Text="{Binding MotionLabel}" FontSize="11" FontAttributes="Bold"
                                   TextColor="{Binding MotionColor}"/>
                        </VerticalStackLayout>
                    </Border>

                    <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource StatTileBorder}">
                        <VerticalStackLayout Spacing="7">
                            <HorizontalStackLayout Spacing="7">
                                <Label Text="GPS SIGNAL" Style="{StaticResource SectionLabel}" VerticalOptions="Center"/>
                            </HorizontalStackLayout>
                            <Label Text="{Binding GpsFixLabel}"
                                   FontSize="20" FontAttributes="Bold"
                                   TextColor="{Binding GpsFixColor}"/>
                            <Label Text="{Binding GpsAccuracyLabel}" FontSize="11"
                                   TextColor="{StaticResource TextMuted}"/>
                        </VerticalStackLayout>
                    </Border>

                    <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource StatTileBorder}">
                        <VerticalStackLayout Spacing="7">
                            <HorizontalStackLayout Spacing="7">
                                <Label Text="HEADING" Style="{StaticResource SectionLabel}" VerticalOptions="Center"/>
                            </HorizontalStackLayout>
                            <Label Text="{Binding HeadingLabel}"
                                   FontSize="20" FontAttributes="Bold"
                                   TextColor="{StaticResource TextMain}"/>
                            <Label Text="bearing" FontSize="11"
                                   TextColor="{StaticResource TextMuted}"/>
                        </VerticalStackLayout>
                    </Border>

                    <Border Grid.Row="2" Grid.Column="0" Style="{StaticResource StatTileBorder}">
                        <VerticalStackLayout Spacing="7">
                            <HorizontalStackLayout Spacing="7">
                                <Label Text="BLADE" Style="{StaticResource SectionLabel}" VerticalOptions="Center"/>
                            </HorizontalStackLayout>
                            <Label Text="{Binding BladeStateLabel}"
                                   FontSize="22" FontAttributes="Bold"
                                   TextColor="{Binding BladeColor}"/>
                        </VerticalStackLayout>
                    </Border>

                    <Border Grid.Row="2" Grid.Column="1" Style="{StaticResource StatTileBorder}">
                        <VerticalStackLayout Spacing="7">
                            <HorizontalStackLayout Spacing="7">
                                <Label Text="MODE" Style="{StaticResource SectionLabel}" VerticalOptions="Center"/>
                            </HorizontalStackLayout>
                            <Label Text="{Binding ModeLabel}"
                                   FontSize="22" FontAttributes="Bold"
                                   TextColor="{Binding ModeColor}"/>
                        </VerticalStackLayout>
                    </Border>

                    <Border Grid.Row="3" Grid.Column="0" Style="{StaticResource StatTileBorder}">
                        <VerticalStackLayout Spacing="7">
                            <HorizontalStackLayout Spacing="7">
                                <Label Text="UPTIME" Style="{StaticResource SectionLabel}" VerticalOptions="Center"/>
                            </HorizontalStackLayout>
                            <Label Text="{Binding UptimeLabel}"
                                   FontSize="22" FontAttributes="Bold"
                                   TextColor="{StaticResource TextMain}"/>
                        </VerticalStackLayout>
                    </Border>

                    <Border Grid.Row="3" Grid.Column="1" Style="{StaticResource StatTileBorder}">
                        <VerticalStackLayout Spacing="7">
                            <HorizontalStackLayout Spacing="7">
                                <Label Text="LAST MOWED" Style="{StaticResource SectionLabel}" VerticalOptions="Center"/>
                            </HorizontalStackLayout>
                            <Label Text="{Binding LastMowedLabel}"
                                   FontSize="20" FontAttributes="Bold"
                                   TextColor="{StaticResource TextMain}"/>
                        </VerticalStackLayout>
                    </Border>

                </Grid>

                </VerticalStackLayout>
                </Grid>

                <Border Style="{StaticResource CardBorder}" IsVisible="{Binding HasRain}"
                        Padding="16,12" BackgroundColor="#E3F2FD">
                    <Grid>
                        <VerticalStackLayout VerticalOptions="Center">
                            <Label Text="RAIN DETECTED" Style="{StaticResource SectionLabel}"/>
                            <Label Text="Mowing paused until the lawn is dry"
                                   FontSize="12" TextColor="{StaticResource TextMain}"/>
                        </VerticalStackLayout>
                    </Grid>
                </Border>

                <Border IsVisible="{Binding ErrorMessage, Converter={StaticResource StringToBool}}"
                        Style="{StaticResource ErrorBanner}">
                    <HorizontalStackLayout Spacing="10">
                        <Label Text="{Binding ErrorMessage}"
                               TextColor="{StaticResource EarthDanger}"
                               FontSize="13" VerticalOptions="Center"
                               LineBreakMode="WordWrap"/>
                    </HorizontalStackLayout>
                </Border>

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
