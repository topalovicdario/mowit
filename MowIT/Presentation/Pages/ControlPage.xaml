<ContentPage
    x:Class="MowIT.Presentation.Pages.ControlPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:MowIT.Presentation.ViewModels"
    xmlns:controls="clr-namespace:MowIT.Presentation.Controls"
    xmlns:skia="clr-namespace:SkiaSharp.Views.Maui.Controls;assembly=SkiaSharp.Views.Maui.Controls"
    xmlns:logging="clr-namespace:MowIT.Application.Logging"
    x:DataType="vm:ControlViewModel"
    Shell.NavBarIsVisible="False"
    BackgroundColor="{StaticResource PageBg}">

<Grid RowDefinitions="Auto,*,Auto,Auto">

<Grid Grid.RowSpan="4" InputTransparent="True">
            <Ellipse Fill="{StaticResource EarthPrimary}" Opacity="0.07"
                     WidthRequest="360" HeightRequest="360"
                     HorizontalOptions="End" VerticalOptions="Start"
                     Margin="0,-130,-130,0"/>
            <Ellipse Fill="{StaticResource EarthAccent}" Opacity="0.06"
                     WidthRequest="260" HeightRequest="260"
                     HorizontalOptions="Start" VerticalOptions="End"
                     Margin="-100,0,0,-90"/>
        </Grid>

<Grid Grid.Row="0" Padding="22,52,22,10" ColumnDefinitions="*,Auto">
            <VerticalStackLayout Spacing="2" VerticalOptions="Center">
                <Label Text="Control"
                       FontSize="30" FontAttributes="Bold"
                       TextColor="{StaticResource TextMain}"/>
                <Label Text="Setup · boundary · drive"
                       FontSize="12" TextColor="{StaticResource TextMuted}"/>
            </VerticalStackLayout>
            <Border Grid.Column="1" Style="{StaticResource IconBadge}">
                <Label Text="🤖" FontSize="22"
                       HorizontalOptions="Center" VerticalOptions="Center"/>
            </Border>
        </Grid>

<ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="18,4,18,16" Spacing="14">

<Border Stroke="Transparent" StrokeShape="RoundRectangle 24"
                        Padding="16" BackgroundColor="{StaticResource CardBg}">
                    <Border.Shadow>
                        <Shadow Brush="#18000000" Offset="0,5" Radius="16"/>
                    </Border.Shadow>

                    <Grid RowDefinitions="Auto,Auto" RowSpacing="16">

<Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                            <Border Grid.Column="0"
                                    WidthRequest="38" HeightRequest="38"
                                    StrokeShape="RoundRectangle 14" Stroke="Transparent"
                                    BackgroundColor="{StaticResource EarthPrimarySoft}">
                                <Label Text="📍" FontSize="18"
                                       HorizontalOptions="Center" VerticalOptions="Center"/>
                            </Border>
                            <VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Center">
                                <Label Text="GPS" FontSize="10" FontAttributes="Bold"
                                       TextColor="{StaticResource TextMuted}" CharacterSpacing="1.8"/>
                                <Label Text="{Binding CurrentGpsText}"
                                       FontSize="14" FontAttributes="Bold"
                                       TextColor="{StaticResource TextMain}"/>
                            </VerticalStackLayout>
                            <Border Grid.Column="2" Padding="9,5"
                                    StrokeShape="RoundRectangle 12" Stroke="Transparent"
                                    BackgroundColor="{StaticResource EarthPrimarySoft}"
                                    VerticalOptions="Center">
                                <Label Text="{Binding GpsAccuracyText}"
                                       FontSize="11" FontAttributes="Bold"
                                       TextColor="{StaticResource EarthPrimaryDark}"/>
                            </Border>
                        </Grid>

<Grid Grid.Row="1" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                            <Border Grid.Column="0"
                                    WidthRequest="38" HeightRequest="38"
                                    StrokeShape="RoundRectangle 14" Stroke="Transparent"
                                    BackgroundColor="#F0F4EE">
                                <Label Text="🏁" FontSize="18"
                                       HorizontalOptions="Center" VerticalOptions="Center"/>
                            </Border>
                            <VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Center">
                                <Label Text="DATUM" FontSize="10" FontAttributes="Bold"
                                       TextColor="{StaticResource TextMuted}" CharacterSpacing="1.8"/>
                                <Label Text="{Binding SetupStatusText}"
                                       FontSize="13"
                                       TextColor="{Binding HasDatum,
                                           Converter={StaticResource BoolToSuccessColor}}"/>
                            </VerticalStackLayout>
                            <Button Grid.Column="2"
                                    Text="📍 Set Base"
                                    Command="{Binding CaptureBaseCommand}"
                                    IsEnabled="{Binding HasGpsFix}"
                                    BackgroundColor="{Binding HasDatum,
                                        Converter={StaticResource BoolToEarthOrGrey}}"
                                    TextColor="White"
                                    CornerRadius="14"
                                    HeightRequest="40"
                                    FontSize="12"
                                    FontAttributes="Bold"
                                    Padding="12,0"
                                    VerticalOptions="Center"/>
                        </Grid>
                    </Grid>
                </Border>

<Border Stroke="Transparent" StrokeShape="RoundRectangle 24"
                        Padding="16" BackgroundColor="{StaticResource CardBg}">
                    <Border.Shadow>
                        <Shadow Brush="#18000000" Offset="0,5" Radius="16"/>
                    </Border.Shadow>
                    <VerticalStackLayout Spacing="12">

<Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                            <Border Grid.Column="0"
                                    WidthRequest="38" HeightRequest="38"
                                    StrokeShape="RoundRectangle 14" Stroke="Transparent"
                                    BackgroundColor="#EEF4EE">
                                <Label Text="🗺" FontSize="18"
                                       HorizontalOptions="Center" VerticalOptions="Center"/>
                            </Border>
                            <VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Center">
                                <Label Text="BOUNDARY" FontSize="10" FontAttributes="Bold"
                                       TextColor="{StaticResource TextMuted}" CharacterSpacing="1.8"/>
                                <Label Text="{Binding RecordingStatusText}"
                                       FontSize="13" TextColor="{StaticResource TextMuted}"/>
                            </VerticalStackLayout>
                            <Border Grid.Column="2" Padding="8,4"
                                    StrokeShape="RoundRectangle 10" Stroke="Transparent"
                                    IsVisible="{Binding IsRecordingBoundary}"
                                    BackgroundColor="#FDECEA"
                                    VerticalOptions="Center">
                                <Label Text="● REC" FontSize="10" FontAttributes="Bold"
                                       TextColor="#E53935"/>
                            </Border>
                        </Grid>

<Label Text="Set GPS base first to enable recording"
                               FontSize="12" TextColor="{StaticResource TextMuted}"
                               HorizontalOptions="Center"
                               IsVisible="{Binding HasDatum,
                                   Converter={StaticResource InvertBool}}"/>

<Button Text="● Record"
                                Command="{Binding StartBoundaryRecordingCommand}"
                                IsEnabled="{Binding CanStartRecording}"
                                IsVisible="{Binding IsNotRecording}"
                                BackgroundColor="{StaticResource EarthPrimary}"
                                TextColor="White"
                                CornerRadius="18"
                                HeightRequest="50"
                                FontSize="15"
                                FontAttributes="Bold"/>

<Border IsVisible="{Binding IsRecordingBoundary}"
                                Stroke="Transparent" StrokeShape="RoundRectangle 18"
                                BackgroundColor="#F5F7F2" Padding="6">
                            <Grid ColumnDefinitions="*,*" ColumnSpacing="6" HeightRequest="84">

                                <Border Grid.Column="0"
                                        Stroke="Transparent" StrokeShape="RoundRectangle 14"
                                        BackgroundColor="{StaticResource EarthPrimary}"
                                        IsEnabled="{Binding CanCapturePoint}"
                                        Opacity="{Binding CanCapturePoint, Converter={StaticResource BoolToOpacity}}">
                                    <Border.Shadow>
                                        <Shadow Brush="#33000000" Offset="0,3" Radius="6"/>
                                    </Border.Shadow>
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding CapturePointCommand}"/>
                                    </Border.GestureRecognizers>
                                    <Grid RowDefinitions="*,Auto,Auto" Padding="0,8">
                                        <Label Grid.Row="0" Text="📌" FontSize="22"
                                               HorizontalOptions="Center" VerticalOptions="Center"/>
                                        <Label Grid.Row="1" Text="Mark"
                                               FontSize="12" FontAttributes="Bold"
                                               TextColor="White"
                                               HorizontalOptions="Center"/>
                                        <Label Grid.Row="2"
                                               Text="{Binding BoundaryPointCount, StringFormat='{0} pts'}"
                                               FontSize="10"
                                               TextColor="#DDFFFFFF"
                                               HorizontalOptions="Center"/>
                                    </Grid>
                                </Border>

                                <Border Grid.Column="1"
                                        Stroke="Transparent" StrokeShape="RoundRectangle 14"
                                        BackgroundColor="#5D7C4A"
                                        IsEnabled="{Binding CanCaptureOutline}"
                                        Opacity="{Binding CanCaptureOutline, Converter={StaticResource BoolToOpacity}}">
                                    <Border.Shadow>
                                        <Shadow Brush="#33000000" Offset="0,3" Radius="6"/>
                                    </Border.Shadow>
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding CaptureOutlineCommand}"/>
                                    </Border.GestureRecognizers>
                                    <Grid RowDefinitions="*,Auto,Auto" Padding="0,8">
                                        <Label Grid.Row="0" Text="＋" FontSize="24"
                                               TextColor="White"
                                               HorizontalOptions="Center" VerticalOptions="Center"/>
                                        <Label Grid.Row="1" Text="New outline"
                                               FontSize="12" FontAttributes="Bold"
                                               TextColor="White"
                                               HorizontalOptions="Center"/>
                                        <Label Grid.Row="2"
                                               Text="{Binding PolygonCount, StringFormat='{0} closed'}"
                                               FontSize="10"
                                               TextColor="#DDFFFFFF"
                                               HorizontalOptions="Center"/>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Border>

                        <Border
    Stroke="Transparent"
    StrokeShape="RoundRectangle 16"
    BackgroundColor="#F0F2EC"
    Padding="10">

                            <VerticalStackLayout Spacing="8">

                                <Grid ColumnDefinitions="*,Auto">
                                    <HorizontalStackLayout Spacing="6">
                                        <Label Text="📡" FontSize="12" VerticalOptions="Center"/>
                                        <Label Text="EVENT LOG"
                       FontSize="10"
                       FontAttributes="Bold"
                       CharacterSpacing="1.5"
                       TextColor="{StaticResource TextMuted}"
                       VerticalOptions="Center"/>
                                    </HorizontalStackLayout>

                                    <Label Grid.Column="1"
                   Text="{Binding EventLog.Entries.Count, StringFormat='{0} events'}"
                   FontSize="10"
                   TextColor="{StaticResource TextMuted}"
                   VerticalOptions="Center"/>
                                </Grid>

                                <CollectionView
            ItemsSource="{Binding EventLog.Entries}"
            HeightRequest="150"
            SelectionMode="None">

                                    <CollectionView.EmptyView>
                                        <Label Text="No events yet"
                       FontSize="11"
                       TextColor="{StaticResource TextMuted}"
                       HorizontalOptions="Center"
                       Margin="0,12"/>
                                    </CollectionView.EmptyView>

                                    <CollectionView.ItemTemplate>
                                        <DataTemplate x:DataType="logging:EventLogEntry">
                                            <Grid
                        Padding="0,3"
                        ColumnDefinitions="88,24,54,*"
                        ColumnSpacing="6">

                                                <Label Grid.Column="0"
                               Text="{Binding TimeText}"
                               FontSize="10"
                               TextColor="{StaticResource TextMuted}"
                               VerticalOptions="Start"/>

                                                <Label Grid.Column="1"
                               Text="{Binding LevelTag}"
                               FontSize="12"
                               FontAttributes="Bold"
                               HorizontalTextAlignment="Center"
                               TextColor="{Binding LevelColor}"
                               VerticalOptions="Start"/>

                                                <Label Grid.Column="2"
                               Text="{Binding Source}"
                               FontSize="10"
                               FontAttributes="Bold"
                               TextColor="{Binding LevelColor}"
                               LineBreakMode="TailTruncation"
                               VerticalOptions="Start"/>

                                                <Label Grid.Column="3"
                               Text="{Binding Message}"
                               FontSize="10"
                               TextColor="{StaticResource TextMain}"
                               LineBreakMode="WordWrap"/>
                                            </Grid>
                                        </DataTemplate>
                                    </CollectionView.ItemTemplate>
                                </CollectionView>

                            </VerticalStackLayout>
                        </Border>

                        <Button Text="✓  Save boundary"
                                Command="{Binding SaveBoundaryCommand}"
                                IsVisible="{Binding IsRecordingBoundary}"
                                IsEnabled="{Binding CanSaveBoundary}"
                                Opacity="{Binding CanSaveBoundary, Converter={StaticResource BoolToOpacity}}"
                                BackgroundColor="{StaticResource EarthPrimaryDark}"
                                TextColor="White" CornerRadius="20"
                                HeightRequest="52" FontSize="15" FontAttributes="Bold"/>
                    </VerticalStackLayout>
                </Border>

<Border Stroke="Transparent" StrokeShape="RoundRectangle 24"
                        Padding="0" HeightRequest="280"
                        BackgroundColor="{StaticResource CardBg}">
                    <Border.Shadow>
                        <Shadow Brush="#18000000" Offset="0,5" Radius="16"/>
                    </Border.Shadow>
                    <Grid>
                        <skia:SKCanvasView x:Name="LocalMap"
                                           PaintSurface="OnLocalMapPaint"
                                           EnableTouchEvents="False"/>
                        <Border HorizontalOptions="Start" VerticalOptions="Start"
                                Margin="10" Padding="8,4"
                                Stroke="Transparent" StrokeShape="RoundRectangle 10"
                                BackgroundColor="#DDFFFFFF">
                            <Label Text="Local map · NEU"
                                   FontSize="10" FontAttributes="Bold"
                                   TextColor="{StaticResource TextMain}"/>
                        </Border>
                        <Border HorizontalOptions="End" VerticalOptions="Start"
                                Margin="10" Padding="8,4"
                                Stroke="Transparent" StrokeShape="RoundRectangle 10"
                                IsVisible="{Binding HasDatum, Converter={StaticResource InvertBool}}"
                                BackgroundColor="#FDECEA">
                            <Label Text="Set base to enable map" FontSize="10"
                                   TextColor="{StaticResource EarthDanger}"/>
                        </Border>
                    </Grid>
                </Border>

            </VerticalStackLayout>
        </ScrollView>

<Border Grid.Row="2"
                IsVisible="{Binding ErrorMessage, Converter={StaticResource StringToBool}}"
                Stroke="Transparent" StrokeShape="Rectangle"
                BackgroundColor="#FDECEA" Padding="18,8">
            <HorizontalStackLayout Spacing="8" HorizontalOptions="Center">
                <Label Text="⚠" TextColor="{StaticResource EarthDanger}"
                       FontSize="14" VerticalOptions="Center"/>
                <Label Text="{Binding ErrorMessage}"
                       TextColor="{StaticResource EarthDanger}"
                       FontSize="12" VerticalOptions="Center" LineBreakMode="WordWrap"/>
            </HorizontalStackLayout>
        </Border>

<Border Grid.Row="3"
                Margin="0"
                Padding="18,14,18,30"
                BackgroundColor="{StaticResource CardBg}"
                Stroke="Transparent">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="28,28,0,0"/>
            </Border.StrokeShape>
            <Border.Shadow>
                <Shadow Brush="#22000000" Offset="0,-6" Radius="18"/>
            </Border.Shadow>

<Grid HeightRequest="200">
                    <Ellipse Stroke="{StaticResource EarthPrimary}" StrokeThickness="1"
                             Opacity="0.15" WidthRequest="220" HeightRequest="220"
                             HorizontalOptions="Center" VerticalOptions="Center"
                             InputTransparent="True"/>
                    <Ellipse Stroke="{StaticResource EarthSoft}" StrokeThickness="1"
                             Opacity="0.28" WidthRequest="156" HeightRequest="156"
                             HorizontalOptions="Center" VerticalOptions="Center"
                             InputTransparent="True"/>
                    <Ellipse Stroke="{StaticResource EarthSoft}" StrokeThickness="1"
                             Opacity="0.20" WidthRequest="94" HeightRequest="94"
                             HorizontalOptions="Center" VerticalOptions="Center"
                             InputTransparent="True"/>
                    <Border HorizontalOptions="Center" VerticalOptions="Start"
                            Margin="0,10" Padding="14,5"
                            StrokeShape="RoundRectangle 12" Stroke="Transparent"
                            IsVisible="{Binding IsManualMode}"
                            InputTransparent="True"
                            BackgroundColor="{Binding IsMotorMoving, Converter={StaticResource BoolToEarthOrGrey}}">
                        <Label Text="{Binding ManualStateText}"
                               FontSize="11" FontAttributes="Bold"
                               TextColor="White"/>
                    </Border>

                    <controls:JoystickView
                        x:Name="JoystickControl"
                        JoystickMoved="OnJoystickMoved"
                        JoystickReleased="OnJoystickReleased"
                        ThumbColor="{StaticResource EarthPrimary}"
                        BackgroundCircleColor="#EDEFE8"/>
            </Grid>
        </Border>

    </Grid>
</ContentPage>
