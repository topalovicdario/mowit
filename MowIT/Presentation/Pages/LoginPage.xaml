<ContentPage
    x:Class="MowIT.Presentation.Pages.LoginPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:MowIT.Presentation.ViewModels"
    x:DataType="vm:LoginViewModel"
    Shell.NavBarIsVisible="False">

    <ContentPage.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="0.4,1">
            <GradientStop Color="#EAF2EA" Offset="0.0"/>
            <GradientStop Color="#F4F6F1" Offset="0.55"/>
            <GradientStop Color="#FAF7F2" Offset="1.0"/>
        </LinearGradientBrush>
    </ContentPage.Background>

    <Grid>

<Ellipse Fill="{StaticResource EarthSoft}" Opacity="0.09"
                 WidthRequest="320" HeightRequest="320"
                 HorizontalOptions="End" VerticalOptions="Start"
                 Margin="0,-100,-90,0" InputTransparent="True"/>
        <Ellipse Fill="{StaticResource EarthAccent}" Opacity="0.07"
                 WidthRequest="220" HeightRequest="220"
                 HorizontalOptions="Start" VerticalOptions="End"
                 Margin="-70,0,0,-70" InputTransparent="True"/>

        <ScrollView>
            <VerticalStackLayout Padding="32,72,32,40" Spacing="0"
                                 HorizontalOptions="{OnIdiom Default=Fill, Desktop=Center}"
                                 WidthRequest="{OnIdiom Default=-1, Desktop=460}">

<Border StrokeShape="Ellipse" Stroke="Transparent"
                        WidthRequest="100" HeightRequest="100"
                        HorizontalOptions="Center">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#75C915" Offset="0.0"/>
                            <GradientStop Color="#4F8F0E" Offset="1.0"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <Border.Shadow>
                        <Shadow Brush="#4875C915" Offset="0,8" Radius="20"/>
                    </Border.Shadow>
                    <Label Text="🌿" FontSize="52"
                           HorizontalOptions="Center" VerticalOptions="Center"/>
                </Border>

<Label Text="MowIT"
                       FontSize="38" FontAttributes="Bold"
                       TextColor="{StaticResource TextMain}"
                       HorizontalOptions="Center"
                       Margin="0,18,0,2"/>
                <Label Text="Smart Garden · Autonomous Control"
                       FontSize="12" TextColor="{StaticResource TextMuted}"
                       HorizontalOptions="Center"
                       CharacterSpacing="0.4"
                       Margin="0,0,0,44"/>

<HorizontalStackLayout Spacing="8" Margin="4,0,0,8">
                    <BoxView Color="{StaticResource EarthPrimary}"
                             WidthRequest="3" HeightRequest="13"
                             VerticalOptions="Center" CornerRadius="2"/>
                    <Label Text="YOUR NAME" Style="{StaticResource SectionLabel}"
                           VerticalOptions="Center"/>
                </HorizontalStackLayout>

<Border Style="{StaticResource InputField}" Margin="0,0,0,18">
                    <Border.Shadow>
                        <Shadow Brush="#14000000" Offset="0,3" Radius="12"/>
                    </Border.Shadow>
                    <Entry Placeholder="Enter your name"
                           Text="{Binding ProfileName}"
                           FontSize="16"
                           TextColor="{StaticResource TextMain}"
                           PlaceholderColor="{StaticResource TextMuted}"/>
                </Border>

<HorizontalStackLayout Spacing="10" Margin="0,0,0,36">
                    <CheckBox IsChecked="{Binding RememberMe}"
                              Color="{StaticResource EarthPrimary}"/>
                    <Label Text="Remember me" FontSize="14"
                           TextColor="{StaticResource TextMain}"
                           VerticalOptions="Center"/>
                </HorizontalStackLayout>

<Button Text="Let's go  →"
                        Command="{Binding ContinueCommand}"
                        Style="{StaticResource PrimaryButton}"/>

<Border IsVisible="{Binding ErrorMessage, Converter={StaticResource StringToBool}}"
                        Style="{StaticResource ErrorBanner}"
                        Margin="0,16,0,0">
                    <Label Text="{Binding ErrorMessage}"
                           TextColor="{StaticResource EarthDanger}"
                           FontSize="13" HorizontalOptions="Center"/>
                </Border>

<Label Text="GreenTitan Autonomous Mower"
                       FontSize="11" TextColor="{StaticResource TextMuted}"
                       HorizontalOptions="Center"
                       Margin="0,32,0,0"/>

            </VerticalStackLayout>
        </ScrollView>

    </Grid>
</ContentPage>
