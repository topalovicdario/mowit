<ContentPage
    x:Class="MowIT.Presentation.Pages.ScanPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:MowIT.Presentation.ViewModels"
    xmlns:entities="clr-namespace:MowIT.Domain.Entities"
    x:DataType="vm:ScanViewModel"
    Shell.NavBarIsVisible="False"
    BackgroundColor="{StaticResource PageBg}">

    <Grid RowDefinitions="Auto,Auto,*,Auto"
          HorizontalOptions="{OnIdiom Default=Fill, Desktop=Center}"
          WidthRequest="{OnIdiom Default=-1, Desktop=600}">

        <Grid Grid.RowSpan="4" InputTransparent="True">
            <Ellipse Fill="{StaticResource EarthPrimary}" Opacity="0.07"
                     WidthRequest="320" HeightRequest="320"
                     HorizontalOptions="End" VerticalOptions="Start"
                     Margin="0,-110,-110,0"/>
            <Ellipse Fill="{StaticResource EarthAccent}" Opacity="0.06"
                     WidthRequest="220" HeightRequest="220"
                     HorizontalOptions="Start" VerticalOptions="End"
                     Margin="-80,0,0,-80"/>
        </Grid>

        <Grid Grid.Row="0" Padding="22,52,22,10" ColumnDefinitions="*,Auto">
            <VerticalStackLayout Spacing="2" VerticalOptions="Center">
                <Label Text="Find Your Mower"
                       FontSize="28" FontAttributes="Bold"
                       TextColor="{StaticResource TextMain}"/>
                <Label Text="{Binding ModeSubtitle}"
                       FontSize="12" TextColor="{StaticResource TextMuted}"/>
            </VerticalStackLayout>
            <Border Grid.Column="1" Style="{StaticResource IconBadge}">
                <Label Text="📡" FontSize="22"
                       HorizontalOptions="Center" VerticalOptions="Center"/>
            </Border>
        </Grid>

        <Border Grid.Row="1" Margin="18,0,18,4"
                Stroke="Transparent" StrokeShape="RoundRectangle 20"
                Padding="16,12" BackgroundColor="{StaticResource CardBg}">
            <Border.Shadow>
                <Shadow Brush="#14000000" Offset="0,4" Radius="14"/>
            </Border.Shadow>
            <VerticalStackLayout Spacing="12">

                <Label Text="CONNECTION TYPE"
                       FontSize="10" FontAttributes="Bold"
                       CharacterSpacing="1.5"
                       TextColor="{StaticResource TextMuted}"/>

                <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                    <Button Grid.Column="0"
                            Text="Bluetooth"
                            Command="{Binding SelectTransportCommand}"
                            CommandParameter="Bluetooth"
                            BackgroundColor="{Binding IsBluetooth, Converter={StaticResource BoolToEarthOrGrey}}"
                            TextColor="White"
                            CornerRadius="14"
                            HeightRequest="40"
                            FontAttributes="Bold"
                            FontSize="13"/>
                    <Button Grid.Column="1"
                            Text="WiFi"
                            Command="{Binding SelectTransportCommand}"
                            CommandParameter="Wifi"
                            BackgroundColor="{Binding IsWifi, Converter={StaticResource BoolToEarthOrGrey}}"
                            TextColor="White"
                            CornerRadius="14"
                            HeightRequest="40"
                            FontAttributes="Bold"
                            FontSize="13"/>
                </Grid>

                <HorizontalStackLayout Spacing="14" VerticalOptions="Center">

                    <Button Text="{Binding ScanButtonText}"
                            Command="{Binding ToggleScanCommand}"
                            BackgroundColor="{Binding IsScanning, Converter={StaticResource StateToColor}}"
                            TextColor="White"
                            CornerRadius="16"
                            HeightRequest="44"
                            Padding="20,0"
                            FontAttributes="Bold"
                            FontSize="14"/>

                    <ActivityIndicator IsRunning="{Binding IsScanning}"
                                       Color="{StaticResource EarthPrimary}"
                                       VerticalOptions="Center"/>

                    <Label Text="Searching..."
                           FontSize="13" TextColor="{StaticResource TextMuted}"
                           VerticalOptions="Center"
                           IsVisible="{Binding IsScanning}"/>
                </HorizontalStackLayout>
            </VerticalStackLayout>
        </Border>

        <CollectionView Grid.Row="2"
                        ItemsSource="{Binding DiscoveredDevices}"
                        Margin="18,0,18,0"
                        SelectionMode="None">

            <CollectionView.EmptyView>
                <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center"
                                     Spacing="16" Margin="0,48">
                    <Border StrokeShape="Ellipse" Stroke="Transparent"
                            BackgroundColor="{StaticResource EarthPrimarySoft}"
                            WidthRequest="88" HeightRequest="88"
                            HorizontalOptions="Center">
                        <Label Text="📡" FontSize="42"
                               HorizontalOptions="Center" VerticalOptions="Center"/>
                    </Border>
                    <Label Text="No devices found"
                           FontSize="17" FontAttributes="Bold"
                           TextColor="{StaticResource TextMain}"
                           HorizontalOptions="Center"/>
                    <Label Text="Pick a connection type above,&#10;then tap Scan"
                           FontSize="13" TextColor="{StaticResource TextMuted}"
                           HorizontalOptions="Center"
                           HorizontalTextAlignment="Center"/>
                </VerticalStackLayout>
            </CollectionView.EmptyView>

            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="entities:MowerDevice">
                    <Border Margin="0,5"
                            Stroke="Transparent" StrokeShape="RoundRectangle 20"
                            Padding="14" BackgroundColor="{StaticResource CardBg}">
                        <Border.Shadow>
                            <Shadow Brush="#10000000" Offset="0,3" Radius="12"/>
                        </Border.Shadow>

                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">

                            <Border Grid.Column="0"
                                    StrokeShape="RoundRectangle 14" Stroke="Transparent"
                                    BackgroundColor="{StaticResource EarthPrimarySoft}"
                                    WidthRequest="48" HeightRequest="48">
                                <Label Text="🤖" FontSize="26"
                                       HorizontalOptions="Center" VerticalOptions="Center"/>
                            </Border>

                            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                                <Label Text="{Binding Name}"
                                       FontSize="16" FontAttributes="Bold"
                                       TextColor="{StaticResource TextMain}"/>
                            </VerticalStackLayout>

                            <Button Grid.Column="2"
                                    Text="Connect"
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ScanViewModel}}, Path=ConnectCommand}"
                                    CommandParameter="{Binding .}"
                                    BackgroundColor="{StaticResource EarthPrimary}"
                                    TextColor="White"
                                    CornerRadius="14"
                                    HeightRequest="40"
                                    FontAttributes="Bold"
                                    FontSize="13"
                                    Padding="14,0"
                                    VerticalOptions="Center"/>
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <VerticalStackLayout Grid.Row="3" Spacing="8" Margin="18,8,18,16">

            <Border IsVisible="{Binding ErrorMessage, Converter={StaticResource StringToBool}}"
                    Padding="14,10"
                    StrokeShape="RoundRectangle 14"
                    Stroke="Transparent"
                    BackgroundColor="#FDECEA">
                <HorizontalStackLayout Spacing="8">
                    <Label Text="⚠" FontSize="15" VerticalOptions="Center"
                           TextColor="{StaticResource EarthDanger}"/>
                    <Label Text="{Binding ErrorMessage}"
                           FontSize="12"
                           TextColor="{StaticResource EarthDanger}"
                           VerticalOptions="Center"
                           LineBreakMode="WordWrap"/>
                </HorizontalStackLayout>
            </Border>

            <Border Padding="16,10"
                    StrokeShape="RoundRectangle 16"
                    Stroke="Transparent"
                    BackgroundColor="{Binding ConnectionState, Converter={StaticResource StateToColor}}">
                <Border.Shadow>
                    <Shadow Brush="#28000000" Offset="0,3" Radius="10"/>
                </Border.Shadow>
                <Label Text="{Binding ConnectionState}"
                       TextColor="White"
                       HorizontalOptions="Center"
                       FontAttributes="Bold"
                       FontSize="14"/>
            </Border>
        </VerticalStackLayout>

    </Grid>
</ContentPage>
